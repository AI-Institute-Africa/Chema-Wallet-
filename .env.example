# Copy to .env for local runs. Never commit real secrets.
PORT=7600
LOG_LEVEL=info
DATABASE_URL=postgres://chema:change-me@localhost:55432/chema
REDIS_URL=redis://localhost:56379

# Flag overrides: CHEMA_FLAG_<KEY with non-alphanumerics as _>, e.g.
