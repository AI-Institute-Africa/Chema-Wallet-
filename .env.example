# Copy to .env for local runs. Never commit real secrets.
PORT=7600
LOG_LEVEL=info
DATABASE_URL=postgres://chema:change-me@localhost:55432/chema
REDIS_URL=redis://localhost:56379

# Flag overrides: CHEMA_FLAG_<KEY with non-alphanumerics as _>, e.g.
# CHEMA_FLAG_RAIL_ECOCASH=true   (mock rail only while live_funds.enabled=false)

# P01 secrets: base64 of 32 random bytes each, e.g. `openssl rand -base64 32`.
# Production injects these from the secrets manager. Placeholders below are
# deliberately invalid so the API refuses to start auth with them.
CHEMA_AUTH_SECRET=generate-me
CHEMA_DATA_KEY=generate-me
# Local encrypted document store
CHEMA_BLOB_DIR=.data/blobs
# P03 mock rails: HMAC secret for mock provider callbacks (>=16 chars). Unset => random per process.
CHEMA_MOCK_WEBHOOK_SECRET=
# P04: base URL of the public web app (share links + QR codes).
CHEMA_PUBLIC_BASE_URL=http://localhost:3000
# P04: HMAC key (>=16 chars) for suspicious-wallet reporter IP hashes; unset => random per process.
CHEMA_REPORT_IP_KEY=
# DEV ONLY: write OTP codes to this file so you can sign in locally (refused when NODE_ENV=production).
# CHEMA_DEV_OTP_FILE=.data/dev-otp.log
# P04: browser origins allowed to call the API (comma-separated); default = CHEMA_PUBLIC_BASE_URL.
CHEMA_WEB_ORIGINS=http://localhost:3000
